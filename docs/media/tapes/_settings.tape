# Shared settings for every tape. scripts/render-tapes.mjs adds them right after the Output line it
# writes, so CI renders and live recordings (same VHS version, pinned in demo-gifs.yml) look alike.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set Width 1100
Set Height 560
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms
