{
  "name": "archkeeper",
  "version": "0.0.0",
  "private": true,
  "description": "One command to give Claude Code a memory of your architecture, decisions and design system.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archkeeper": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "modules",
    "packs",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arbindpd96/archkeeper.git"
  },
  "engines": {
    "node": "^22.17.1 || ^24.4.1 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "comments": "node scripts/check-comments.mjs",
    "brand": "node scripts/check-brand.mjs",
    "build": "tsdown && node scripts/third-party-licenses.mjs",
    "package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:quick": "npm run typecheck && npm test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run comments && npm run brand && npm test && npm run build && npm run package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored --config eslint.config.mjs",
      "node scripts/check-comments.mjs"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsdown": "0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
